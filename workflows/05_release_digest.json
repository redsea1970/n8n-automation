      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\nfor (const item of items) {\n  const xml = item.json.data;\n  const regex = /<entry>[\\s\\S]*?<title>(.*?)<\\/title>[\\s\\S]*?<updated>(.*?)<\\/updated>/g;\n  let match;\n  let count = 0;\n  while ((match = regex.exec(xml)) !== null && count < 3) {\n    result.push({\n      json: {\n        Title: match[1],\n        Date: match[2].slice(0, 10)\n      }\n    });\n    count++;\n  }\n}\nreturn result;"
      },
